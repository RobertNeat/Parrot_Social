# on server this file is config.env

# === Metadane obrazu OCI (używane przez .github/steps/create_docker_image.sh) ===
# IMAGE_TITLE - tytuł obrazu (etykieta OCI org.opencontainers.image.title)
# IMAGE_DESCRIPTION - opis obrazu (etykieta OCI org.opencontainers.image.description)
# IMAGE_VENDOR - nazwa dostawcy/organizacji (etykieta OCI org.opencontainers.image.vendor)
# IMAGE_LICENSES - identyfikator licencji wg SPDX, np. "UNLICENSED", "MIT" (org.opencontainers.image.licenses)
# IMAGE_SOURCE - URL repozytorium źródłowego (org.opencontainers.image.source)
IMAGE_TITLE="Parrot Social"
IMAGE_DESCRIPTION="Parrot Social monorepo - parrot_api (NestJS) + parrot_web (Angular)"
IMAGE_VENDOR="Parrot Social"
IMAGE_LICENSES="UNLICENSED"
IMAGE_SOURCE="https://github.com/RobertNeat/Parrot_Social"

# === PostgreSQL (container: postgres, volume: postgres-data) ===
# PARROT_DB_NAME - nazwa bazy danych
# PARROT_DB_USER - użytkownik bazy danych
# PARROT_DB_PASSWORD - hasło użytkownika bazy danych (zmienić przed wdrożeniem na produkcję)
# PARROT_DB_HOST_PORT - port hosta mapowany na 5432 w kontenerze (tylko lokalnie,
#   nadpisywany w deploy/compose.dev.yml na loopback 127.0.0.1); domyślnie 10720
PARROT_DB_NAME=parrot_social
PARROT_DB_USER=parrot
PARROT_DB_PASSWORD=change-me-before-deploy
PARROT_DB_HOST_PORT=10720

# === Migracje (container: liquibase, jednorazowy, przed startem parrot-api) ===
# PARROT_LIQUIBASE_CONTEXTS - konteksty dla Liquibase:
#   "schema" - tylko DDL (struktura bazy, bez danych)
#   "schema,seed" - DDL + mockowe dane startowe (konta/posty/grupy/wydarzenia
#     testowe + zdjęcia z deploy/liquibase/seed/media, zob. PARROT_SEED_MEDIA_DIR
#     poniżej); można też użyć na produkcji, jeśli to środowisko testowe
PARROT_LIQUIBASE_CONTEXTS=schema

# === Auth (container: parrot-api) ===
# JWT_SECRET - sekret do podpisywania tokenów JWT; MUSI zostać zmieniony przed
#   wdrożeniem na produkcję
JWT_SECRET=change-me-before-deploy

# === Sieć / CORS (container: parrot-api, parrot-web) ===
# PARROT_WEB_ORIGIN - pochodzenie(a) frontendu dopuszczone przez CORS backendu;
#   lista rozdzielona przecinkami; domyślnie w kodzie (brak tej zmiennej) obejmuje
#   compose i `ng serve` (oba na 10700, zob. apps/parrot_web/angular.json), plus
#   4200 jako fallback dla `ng serve --port 4200`
# PARROT_API_PUBLIC_ORIGIN - pochodzenie backendu widoczne z przeglądarki
#   (parrot-web i parrot-api są osobnymi originami - nginx nie proxuje /media -
#   więc <img src> musi wskazywać na ten adres bezpośrednio, nie na względną ścieżkę)
PARROT_WEB_ORIGIN=http://localhost:10700,http://localhost:4200
PARROT_API_PUBLIC_ORIGIN=http://localhost:10710

# === Porty API/web (container: parrot-api, parrot-web) ===
# PARROT_API_HOST_PORT - port hosta mapowany na kontener parrot-api; domyślnie 10710
# PARROT_API_CONTAINER_PORT - port nasłuchu w kontenerze parrot-api; domyślnie 10710
# PARROT_WEB_HOST_PORT - port hosta mapowany na kontener parrot-web; domyślnie 10700
# PARROT_WEB_CONTAINER_PORT - port nasłuchu w kontenerze parrot-web; domyślnie 10700
# (wartości domyślne pochodzą z projects.json - patrz compose.yml; lokalnie
#  nadpisywane w deploy/compose.dev.yml na loopback 127.0.0.1)
# PARROT_API_HOST_PORT=10710
# PARROT_API_CONTAINER_PORT=10710
# PARROT_WEB_HOST_PORT=10700
# PARROT_WEB_CONTAINER_PORT=10700

# === Media (container: parrot-api, volume: parrot-media) ===
# PARROT_SEED_MEDIA_DIR - katalog (w kontenerze) z plikami medialnymi seed danych
#   (avatary i obrazki postów, zob. deploy/liquibase/seed/media/); ustawiane
#   TRWALE przez deploy/compose.yml (bind mount read-only) na "/seed-media" -
#   serwowane tylko gdy wiersze w tabeli `media` wskazują na te pliki, czyli gdy
#   PARROT_LIQUIBASE_CONTEXTS zawiera "seed". Wartość jest zahardkodowana w
#   compose.yml (environment:), więc wpis w .env/config.env NIC nie zmienia -
#   wystarczy włączyć kontekst "seed" wyżej, nie trzeba tu niczego ustawiać
# PARROT_SEED_MEDIA_DIR=/seed-media
