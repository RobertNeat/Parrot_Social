# Lokalne/startowe wartości środowiskowe dla stosu Parrot Social.
#  - lokalnie: skopiuj do .env i użyj z docker compose (zob. deploy/compose.dev.yml)
#  - produkcja: ten plik jest kopiowany na serwer jako config.env tylko przy
#    pierwszym wdrożeniu (jeśli zdalny config.env jeszcze nie istnieje) - patrz
#    .github/steps/deploy_compose_ssh.sh. Hasła poniżej są przykładowe i MUSZĄ
#    zostać zmienione przed pierwszym wdrożeniem na produkcję.

# Metadane obrazu OCI (używane przez .github/steps/create_docker_image.sh)
IMAGE_TITLE="Parrot Social"
IMAGE_DESCRIPTION="Parrot Social monorepo - parrot_api (NestJS) + parrot_web (Angular)"
IMAGE_VENDOR="Parrot Social"
IMAGE_LICENSES="UNLICENSED"
IMAGE_SOURCE="https://github.com/RobertNeat/Parrot_Social"

# Baza danych PostgreSQL
PARROT_DB_NAME=parrot_social
PARROT_DB_USER=parrot
PARROT_DB_PASSWORD=change-me-before-deploy

# Migracje / seed danych (Liquibase)
PARROT_SEED_DATA=false

# Pochodzenie frontendu dopuszczone przez CORS backendu
PARROT_WEB_ORIGIN=http://localhost:10700

# Porty lokalne (nadpisywane w deploy/compose.dev.yml na loopback)
PARROT_DB_HOST_PORT=10720
