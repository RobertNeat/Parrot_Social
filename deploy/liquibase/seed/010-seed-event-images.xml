<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Obrazki wydarzeń - odwzorowanie oryginalnych mock-data.ts (eventImg('event_N.png')),
         przywrócone po tym jak 004-seed-events.xml zostawił image_media_id NULL (plik wtedy
         nie istniał w wolumenie). Pliki skopiowane z apps/parrot_web/public/resources/event/
         do deploy/liquibase/seed/media/ (zob. 009-seed-media.xml dla wzorca bind-mountu) -
         trzymane tu osobno, żeby można było łatwo podmienić bez grzebania w głównym pliku
         media. Tylko 4 unikalne obrazki na 6 eventów (na życzenie: żaden plik nie może się
         powtórzyć) - Underground Beats Night i New Year Fireworks zostają bez zdjęcia,
         fallback na neutralny placeholder we frontendzie (events.service.ts). -->
    <changeSet id="seed-010-event-images" author="robert.sereda" context="seed">
        <insert tableName="media">
            <column name="id" value="00000000-0000-0000-0010-000000000042"/>
            <column name="stored_file_name" value="event_1.png"/>
            <column name="original_file_name" value="event_1.png"/>
            <column name="mime_type" value="image/png"/>
            <column name="size" valueNumeric="208845"/>
            <column name="owner_id" value="00000000-0000-0000-0001-000000000001"/>
