<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Dopięcie FK media.owner_id -> users.id teraz, gdy tabela users już istnieje.
         Dodane jako osobny changeSet (nie edycja 001-media.xml) - zmienianie treści
         changesetu, który mógł już zostać zastosowany, jest złą praktyką w Liquibase.
         ON DELETE CASCADE - medium bez właściciela (po usunięciu konta) nie ma sensu
         biznesowego, więc usuwamy je razem z użytkownikiem. -->
    <changeSet id="003-media-owner-fk" author="robert.sereda">
        <addForeignKeyConstraint
            baseTableName="media" baseColumnNames="owner_id"
            constraintName="fk_media_owner"
            referencedTableName="users" referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
