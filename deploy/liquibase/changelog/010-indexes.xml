<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Postgres nie indeksuje automatycznie kolumn FK (w przeciwieństwie do PK), a
         indeks na kompozytowym PK (np. group_member) pokrywa tylko pierwszą kolumnę
         w porządku zapytań WHERE - stąd osobne indeksy na drugiej kolumnie każdej
         tabeli łączącej, żeby "pokaż grupy/eventy/konwersacje danego użytkownika"
         nie robiło pełnego skanu tabeli. -->
    <changeSet id="010-index-post-author" author="robert.sereda">
        <createIndex tableName="post" indexName="ix_post_author">
            <column name="author_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-post-group" author="robert.sereda">
        <createIndex tableName="post" indexName="ix_post_group">
            <column name="group_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-comment-post" author="robert.sereda">
        <createIndex tableName="comment" indexName="ix_comment_post">
            <column name="post_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-chat-message-conversation" author="robert.sereda">
        <createIndex tableName="chat_message" indexName="ix_chat_message_conversation">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-notification-recipient" author="robert.sereda">
        <createIndex tableName="notification" indexName="ix_notification_recipient">
            <column name="recipient_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-group-member-user" author="robert.sereda">
        <createIndex tableName="group_member" indexName="ix_group_member_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-event-interest-user" author="robert.sereda">
        <createIndex tableName="event_interest" indexName="ix_event_interest_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-conversation-participant-user" author="robert.sereda">
        <createIndex tableName="conversation_participant" indexName="ix_conv_participant_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-post-like-user" author="robert.sereda">
        <createIndex tableName="post_like" indexName="ix_post_like_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-post-upvote-user" author="robert.sereda">
        <createIndex tableName="post_upvote" indexName="ix_post_upvote_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-index-friendship-addressee" author="robert.sereda">
        <createIndex tableName="friendship" indexName="ix_friendship_addressee">
            <column name="addressee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
